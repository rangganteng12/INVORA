/* =========================================
   TEMA DAN ASET
   ========================================= */
:root {
  --m: #6b1f3a;
  --m2: #8a3a55;
  --cr: #f2e6a4;
  --pp: #f7faf6;

  --gar: url("assets/passport-emblem.webp");
  --guil: url("assets/passport-security-pattern.webp");
  --mapl: url("assets/map-light.svg");
  --mapd: url("assets/map-dark.svg");

  --bar: none;
  --mono: 'Space Mono', ui-monospace, monospace;
  --sg: 'Space Grotesk', system-ui, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  -webkit-tap-highlight-color: transparent;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #d9d4d6;
  font: 400 13px/1.5 var(--mono);
  color: #2a1620;
}

body.lock {
  overflow: hidden;
  height: 100%;
}

@media screen and (min-width: 760px) {
  .col {
    width: min(98vw, 1600px);
    margin: 0 auto;
  }
}

/* Tampilan website pada PC dan laptop */
@media screen and (min-width: 760px) {
  .col {
    width: min(96vw, 1180px);
  }
}

#app {
  background: var(--pp);
  position: relative;
  overflow: hidden;
  padding-bottom: 120px;
}

.mapl {
  background: var(--mapl) center/130% auto no-repeat;
}

.mapd {
  background: var(--mapd) center/130% auto no-repeat;
}

/* =========================================
   COVER BARU: BACKGROUND PC DAN HP
   ========================================= */
#cover {
  position: fixed;
  z-index: 60;
  top: 0;
  bottom: 0;
  left: 50%;
  width: min(100vw, 430px);
  margin-left: calc(min(100vw, 430px) / -2);
  overflow: hidden;
  isolation: isolate;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 28px 22px;
  color: var(--cr);
  text-align: center;
  background: var(--m);

  transition: transform 1.05s cubic-bezier(.65, 0, .3, 1);
}

/* Lapisan gambar memenuhi cover */
#cover > picture.cover-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

#cover > picture.cover-background img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Lapisan transparan agar teks mudah dibaca */
#cover::before {
  content: "";
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(38, 5, 17, .04),
    rgba(38, 5, 17, .16)
  );
  pointer-events: none;
}

/* Bingkai emas */
#cover::after {
  content: "";
  position: absolute;
  z-index: 4;
  inset: 12px;
  border: 1px solid rgba(242, 230, 164, .38);
  outline: 1px solid rgba(242, 230, 164, .15);
  outline-offset: 4px;
  pointer-events: none;
}

/* Pastikan isi cover selalu berada di atas background */
#cover > *:not(picture) {
  position: relative;
  z-index: 2;
}

#cover .ttl,
#cover .cmp,
#cover .to,
#cover .btn {
  position: relative;
  z-index: 2;
}

/* Urutan cover pada HP */
#cover .cover-copy {
  display: contents;
}

#cover .ttl {
  order: 1;
  text-shadow: 0 2px 18px rgba(20, 0, 10, .35);
}

#cover .cmp {
  order: 2;
  width: min(80vw, 330px);
  margin: 16px 0 8px;
}

#cover .to {
  order: 3;
  text-shadow: 0 1px 8px rgba(20, 0, 10, .35);
}

#cover .btn {
  order: 4;
  box-shadow: 0 3px 16px rgba(30, 0, 10, .18);
}

/* =========================================
   COVER PADA PC / LAPTOP
   ========================================= */
@media (min-width: 760px) {
  #cover {
    left: 0;
    width: 100%;
    margin-left: 0;

    padding: clamp(36px, 5vh, 64px)
      clamp(48px, 8vw, 132px);

    display: grid;
    grid-template-columns:
      minmax(280px, .9fr)
      minmax(320px, 1.1fr);

    column-gap: clamp(28px, 5vw, 84px);
    align-items: center;
    text-align: left;
  }

  #cover::after {
    inset: 26px;
    outline-offset: 5px;
  }

  #cover .cover-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-self: end;

    grid-column: 1;
    grid-row: 1;

    width: 100%;
    max-width: 520px;
  }

  #cover .ttl {
    order: 0;
    font-size: clamp(28px, 3.2vw, 44px);
    letter-spacing: .16em;
  }

  #cover .ttl b {
    font-size: clamp(44px, 5.6vw, 72px);
  }

  #cover .to {
    order: 0;
    margin-top: clamp(24px, 4vh, 44px);
    font-size: clamp(13px, 1.1vw, 16px);
  }

  #cover .to b {
    font-size: 1.12em;
    margin: 8px 0 16px;
  }

  #cover .btn {
    order: 0;
    margin-top: 8px;
    padding: 13px 22px;
    font-size: 14px;
  }

  #cover .cmp {
    order: 0;
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    align-self: center;
    width: min(40vw, 460px);
    margin: 0;
  }
}

/* Animasi cover dibuka */
.open #cover {
  transform: translateY(-100%);
}

/* =========================================
   JUDUL DAN KOMPAS
   ========================================= */
.ttl {
  position: relative;
  font: 500 20px/1 'Playfair Display', serif;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.ttl b {
  display: block;
  font: 700 30px/1.15 'Playfair Display', serif;
  letter-spacing: .04em;
}

.cmp {
  position: relative;
  width: min(80vw, 330px);
  aspect-ratio: 1;
  margin: 16px 0 8px;
}

.cmp svg,
.hr svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.rose {
  transform-box: view-box;
  transform-origin: 150px 150px;
  animation: sw 10s infinite ease-in-out;
}

@keyframes sw {
  0%   { transform: rotate(-36deg); }
  10%  { transform: rotate(360deg); }
  22%  { transform: rotate(-12deg); }
  34%  { transform: rotate(58deg); }
  46%  { transform: rotate(8deg); }
  60%  { transform: rotate(-50deg); }
  74%  { transform: rotate(20deg); }
  88%  { transform: rotate(-20deg); }
  100% { transform: rotate(-35deg); }
}

.arc {
  font-family: 'Special Elite', serif;
}

.to {
  position: relative;
  font-size: 13px;
  line-height: 1.35;
}

.to b {
  display: block;
  font-size: 15px;
  margin: 6px 0 14px;
}

.btn {
  position: relative;
  font: 400 13px var(--mono);
  background: var(--cr);
  color: #3a1a24;
  border: 0;
  border-radius: 8px;
  padding: 9px 16px;
  cursor: pointer;
  transition: transform .2s;
}

.btn:active {
  transform: scale(.96);
}

/* =========================================
   HALAMAN UTAMA
   ========================================= */
/* =========================================
   ROYAL WEDDING PASSPORT — HALAMAN UTAMA
   ========================================= */

#home {
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 11svh 20px 120px;
  text-align: center;

  position: relative;
  isolation: isolate;
  overflow: hidden;

  background: #faf0e0;
}

/* Background dengan cahaya dan nuansa emas */
#home::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  background-image:
    radial-gradient(
      circle at 50% 34%,
      rgba(255, 255, 255, .72),
      transparent 35%
    ),
    radial-gradient(
      circle at 12% 50%,
      rgba(209, 160, 100, .16),
      transparent 35%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(107, 31, 58, .10),
      transparent 32%
    ),
    url("./assets/background%20awal%20hp.png");

  background-size:
    cover,
    cover,
    cover,
    cover;

  background-position: center;
  background-repeat: no-repeat;
}

/* Bingkai emas di sekeliling halaman */
#home::after {
  content: "";
  position: absolute;
  inset: 13px;
  z-index: 0;
  pointer-events: none;

  border: 1px solid rgba(164, 119, 57, .48);
  outline: 1px solid rgba(164, 119, 57, .20);
  outline-offset: 4px;

  box-shadow:
    inset 0 0 35px rgba(167, 119, 57, .08),
    0 0 15px rgba(167, 119, 57, .06);
}

/* Konten selalu berada di depan background */
#home > .ttl,
#home > .hr,
#home > .msc,
#home > .deco {
  position: relative;
  z-index: 2;
}

/* Judul */
#home .ttl {
  color: var(--m);
  font-family: "Cormorant SC", serif;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: .22em;

  text-shadow:
    0 2px 0 rgba(255, 255, 255, .75),
    0 4px 14px rgba(107, 31, 58, .13);
}

/* Kalimat kecil di atas judul */
#home .ttl::before {
  content: "✦  OUR JOURNEY OF LOVE  ✦";

  display: block;
  margin-bottom: 13px;

  color: #a67d45;
  font-family: "Space Mono", monospace;
  font-size: 9px;
  font-weight: 400;
  letter-spacing: .19em;
}

/* Kata Passport */
#home .ttl b {
  display: block;
  margin-top: 5px;

  font-family: "Playfair Display", serif;
  font-size: 38px;
  font-weight: 700;
  letter-spacing: .045em;

  color: var(--m);
}

/* Area logo kompas */
#home .hr {
  position: relative;
  isolation: isolate;

  width: min(82vw, 340px);
  aspect-ratio: 1;
  margin: 34px 0 26px;
}

/* Lingkaran emas di belakang logo */
#home .hr::before {
  content: "";
  position: absolute;
  z-index: -1;

  inset: 4%;
  border-radius: 50%;
  border: 1px solid rgba(172, 124, 54, .85);

  box-shadow:
    0 0 0 5px rgba(255, 255, 255, .25),
    0 0 0 7px rgba(172, 124, 54, .26),
    0 0 28px rgba(172, 124, 54, .22),
    inset 0 0 25px rgba(172, 124, 54, .10);
}

/* Garis lingkaran putus-putus */
#home .hr::after {
  content: "";
  position: absolute;
  z-index: -1;

  inset: -3%;
  border: 1px dashed rgba(107, 31, 58, .42);
  border-radius: 50%;

  animation: royal-orbit 55s linear infinite;
}

/* Logo asli tetap memakai SVG dan asset yang ada */
#home .hr svg {
  position: relative;
  z-index: 1;

  width: 100%;
  height: 100%;
  overflow: visible;

  filter:
    drop-shadow(0 5px 8px rgba(73, 27, 35, .18));
}

/* Kompas utama berputar perlahan */
#home .hr image {
  transform-box: fill-box;
  transform-origin: center;
  animation: compass-spin 40s linear infinite;
}

@keyframes compass-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* Kilau bergerak pada lingkaran luar */
@keyframes royal-orbit {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* Animasi logo lama tetap aktif */
#home .hr .ring {
  transform-origin: 50% 50%;
}

.open #home .hr .ring {
  animation:
    grow 1.3s .65s cubic-bezier(.2, .8, .2, 1) both;
}

.open #home .ttl {
  animation: fd 1s .6s both;
}

@keyframes grow {
  from {
    transform: scale(.45);
    opacity: 0;
  }
}

@keyframes fd {
  from {
    opacity: 0;
    transform: translateY(-14px);
  }
}

/* Tombol petunjuk scroll */
#home .msc {
  width: 46px;
  height: 66px;
  overflow: visible;

  padding: 4px;
  border: 1px solid rgba(164, 119, 57, .55);
  border-radius: 24px;

  background: rgba(255, 250, 239, .78);
  box-shadow: 0 4px 16px rgba(107, 31, 58, .12);
}

#home .msc rect {
  fill: none;
  stroke: #7a3448;
  stroke-width: 1.6;
  stroke-dasharray: 190;
  stroke-dashoffset: 190;
}

.open #home .msc rect {
  animation: dr 1.4s 1.1s forwards;
}

@keyframes dr {
  to {
    stroke-dashoffset: 0;
  }
}

#home .msc path {
  fill: none;
  stroke: #7a3448;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0;
}

.open #home .msc path {
  animation: ar 1.4s 2s infinite;
}

@keyframes ar {
  0% {
    opacity: 0;
    transform: translateY(-6px);
  }

  30% {
    opacity: 1;
  }

  70% {
    opacity: 1;
    transform: translateY(6px);
  }

  100% {
    opacity: 0;
    transform: translateY(8px);
  }
}

/* Ornamen dekoratif */
#home .deco {
  position: absolute;
  z-index: 2;
  pointer-events: none;

  color: #a67d45;
  opacity: .78;

  filter: drop-shadow(0 2px 5px rgba(107, 31, 58, .12));
}

/* Layar website / PC */
@media screen and (min-width: 760px) {
  #home {
    padding-top: 9svh;
  }

  #home::before {
    background-image:
      radial-gradient(
        circle at 50% 35%,
        rgba(255, 255, 255, .72),
        transparent 40%
      ),
      radial-gradient(
        circle at 15% 70%,
        rgba(209, 160, 100, .13),
        transparent 35%
      ),
      url("./assets/background%20awal%20web.png");

    background-size: cover;
    background-position: center;
  }

  #home::after {
    inset: 20px;
  }

  #home .ttl {
    font-size: 28px;
  }

  #home .ttl b {
    font-size: 44px;
  }

  #home .hr {
    width: min(34vw, 370px);
    margin: 30px 0;
  }
}

/* =========================================
   BAGIAN GELAP
   ========================================= */
/* =========================================
   ROYAL WEDDING PASSPORT — COUPLE SECTION
   ========================================= */

.dk {
  position: relative;
  color: var(--cr);
  background:
    linear-gradient(
      180deg,
      rgba(64, 12, 31, .12),
      rgba(64, 12, 31, .45)
    ),
    var(--m) var(--mapd) 50% 0 / 140% auto no-repeat;
}

/* =========================================
   PERBAIKAN COUPLE: KONTRAS DAN JARAK
   ========================================= */

#couple.dk {
  background-color: #f8eade !important;

  background-image:
    linear-gradient(
      rgba(255, 248, 238, 0.48),
      rgba(255, 248, 238, 0.58)
    ),
    url("./assets/background-couple-mobile.png") !important;

  background-position: center top;
  background-size: cover;
  background-repeat: no-repeat;

  color: #5a1c33 !important;
}

/* Label dan judul agar tidak bertabrakan dengan ornamen */
#couple .couple-kicker {
  display: table;
  margin: 0 auto 14px;
  padding: 6px 12px;

  color: #8a3a55 !important;
  background: rgba(255, 248, 238, 0.88);
  border: 1px solid rgba(166, 125, 69, 0.55);
  border-radius: 20px;
}

#couple .couple-title {
  display: table;
  margin: 0 auto 24px;
  padding: 10px 18px;

  color: #6b1f3a !important;
  background: rgba(255, 248, 238, 0.88);
  border: 1px solid rgba(166, 125, 69, 0.48);
  border-radius: 6px;

  text-shadow: none;
}

#couple .couple-title span {
  color: #8a3a55 !important;
}

/* Panel ayat dibuat lebih solid */
#couple .verse-box {
  background: rgba(255, 250, 243, 0.97) !important;
  border: 1px solid #c6a36b;
  box-shadow: 0 6px 22px rgba(65, 20, 35, 0.12);
}

#couple .verse-label,
#couple .verse-ref {
  color: #8a3a55 !important;
}

#couple .ar {
  color: #5a1c33 !important;
}

#couple .q {
  color: #51283a !important;
}

/* Salam dan isi undangan */
#couple .sal {
  color: #8a3a55 !important;
}

#couple .op {
  color: #51283a !important;
}

#couple .op-highlight {
  color: #762b46 !important;
}

/* Pastikan teks kutipan tidak menghilang */
#couple .rv:not(.card) {
  opacity: 1 !important;
  transform: none !important;
}

/* Beri ruang antara teks terakhir dan kartu paspor */
#couple .couple-divider {
  margin: 28px auto 38px;
}

#couple #pps {
  margin: 0 auto 45px;
}

/* Background horizontal untuk PC */
@media screen and (min-width: 760px) {
  #couple.dk {
    background-image:
      linear-gradient(
        rgba(255, 248, 238, 0.48),
        rgba(255, 248, 238, 0.58)
      ),
      url("./assets/background-couple-desktop.png") !important;
  }

  #couple .verse-box {
    max-width: 480px;
  }

  #couple .op {
    max-width: 460px;
  }
}

/* Area pengenalan pasangan */
#couple {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  min-height: 100svh;
  padding: 48px 20px 42px;
  text-align: center;
}

/* Bingkai emas */
#couple::before {
  content: "";
  position: absolute;
  inset: 13px;
  z-index: -1;

  border: 1px solid rgba(242, 230, 164, .42);
  outline: 1px solid rgba(242, 230, 164, .16);
  outline-offset: 4px;

  pointer-events: none;
}

/* Label kecil */
.couple-kicker {
  color: #e5c887;
  font: 400 9px/1.5 var(--mono);
  letter-spacing: .2em;
  margin-bottom: 12px;
}

/* Judul utama */
.couple-title {
  color: #fff0c7;
  font: 600 27px/1.2 "Cormorant SC", serif;
  letter-spacing: .06em;
  margin: 0 0 24px;

  text-shadow: 0 2px 12px rgba(0, 0, 0, .15);
}

.couple-title span {
  display: block;
  color: #e8c98c;
  font-size: 32px;
  margin-top: 3px;
}

/* Panel ayat */
.verse-box {
  position: relative;
  width: 100%;
  max-width: 360px;

  margin: 0 auto 25px;
  padding: 20px 16px 19px;

  border: 1px solid rgba(242, 230, 164, .5);
  border-radius: 4px;

  background: rgba(46, 8, 24, .22);

  box-shadow:
    inset 0 0 24px rgba(242, 230, 164, .035),
    0 8px 24px rgba(25, 0, 10, .1);
}

/* Label ayat */
.verse-label {
  color: #dfbd79;
  font: 400 9px var(--mono);
  letter-spacing: .18em;
  margin-bottom: 18px;
}

/* Tulisan Arab */
#couple .ar {
  color: #fff0c7;
  direction: rtl;
  text-align: center;

  font-family: "Amiri", "Times New Roman", serif;
  font-size: 22px;
  line-height: 1.9;

  margin: 0 auto 14px;
}

/* Ornamen pemisah */
.verse-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  color: #e5c887;
  margin: 13px auto;
}

.verse-divider::before,
.verse-divider::after {
  content: "";
  height: 1px;
  width: 48px;
  background: rgba(242, 230, 164, .5);
}

/* Terjemahan */
#couple .q {
  max-width: 310px;
  margin: 0 auto 12px;

  color: #fff5dc;
  text-align: center;

  font: 400 12px/1.85 var(--sg);
}

/* Referensi ayat */
.verse-ref {
  color: #e8c98c;
  font: 700 10px var(--mono);
  letter-spacing: .08em;
  margin-top: 12px;
}

/* Salam */
#couple .sal {
  color: #f2dca7;
  font: 400 31px/1.3 "Mrs Saint Delafield", cursive;
  text-align: center;

  margin: 25px 0 13px;
}

/* Isi undangan */
#couple .op {
  width: 100%;
  max-width: 350px;

  color: #fff0d1;
  font: 400 12px/1.9 var(--sg);

  text-align: center;
  margin: 0 auto 22px;
}

/* Penekanan pada kalimat penutup */
.op-highlight {
  display: block;
  color: #e9cb91;
  margin-top: 10px;
}

/* Ornamen sebelum kartu paspor */
.couple-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  color: #e5c887;
  margin: 25px auto 30px;
}

.couple-divider i {
  display: block;
  width: 85px;
  height: 1px;
  background: rgba(242, 230, 164, .55);
}

/* Kartu profil berada di tengah */
#couple #pps {
  width: 100%;
  max-width: 360px;
  margin: 0 auto;
}

/* Ukuran HP yang sangat kecil */
@media screen and (max-width: 360px) {
  #couple {
    padding: 40px 17px 35px;
  }

  .couple-title {
    font-size: 24px;
  }

  .couple-title span {
    font-size: 29px;
  }

  #couple .ar {
    font-size: 20px;
  }

  #couple .sal {
    font-size: 28px;
  }
}

/* =========================================
   KARTU PASANGAN
   ========================================= */
.pp {
  position: relative;
  background: #fbfdfa var(--guil);
  border-radius: 16px;
  padding: 16px 16px 14px;
  margin: 0 0 20px;
  color: #2a1620;
  box-shadow: 0 8px 24px #0004;
  overflow: hidden;
}

.pp::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 18px;
  width: 62%;
  aspect-ratio: 1/1.03;
  transform: translateX(-50%);
  background: var(--gar) center/contain no-repeat;
  opacity: .13;
}

.pp > * {
  position: relative;
}

.pp .rep {
  text-align: center;
  font-size: 11px;
  letter-spacing: .04em;
  margin: -2px 0 6px;
}

.pp h5 {
  font: 700 15px var(--mono);
  color: var(--m);
}

.pp h5 + small {
  display: block;
  font-size: 11px;
  margin-bottom: 8px;
}

.top {
  display: flex;
  gap: 14px;
}

.pic {
  flex: none;
  width: 34%;
  aspect-ratio: 3/3.8;
  border-radius: 4px;
  overflow: hidden;
  background: linear-gradient(160deg, #cfd6dd, #8d9aa8);
}

.pic svg,
.pic img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

dl dt {
  font-size: 9.5px;
  color: var(--m);
  letter-spacing: .02em;
  margin-top: 8px;
}

dl dt:first-child {
  margin-top: 0;
}

dl dd {
  font: 700 14px/1.3 var(--mono);
}

dl dd.s {
  font-weight: 400;
  font-size: 13px;
}

.fold {
  height: 16px;
  margin: 10px -16px 4px;
  background: linear-gradient(180deg, #0000, #0000001f 55%, #0000);
}

.pp hr {
  border: 0;
  border-top: 1.5px solid var(--m);
  margin: 12px 0 8px;
}

.mrz {
  font-size: 11.5px;
  letter-spacing: .01em;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
}

.stamp {
  position: absolute !important;
  right: 10px;
  bottom: 48px;
  width: 76px;
  opacity: .28;
  color: #7a6a74;
}

/* =========================================
   BAGIAN TERANG
   ========================================= */
.sec {
  padding: 34px 16px 6px;
  position: relative;
}

#date {
  text-align: center;
  padding-top: 44px;
}

#date p {
  font-size: 14px;
  line-height: 1.35;
}

.cd {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin: 12px 0 16px;
}

.cd div {
  font: 700 21px/1.1 var(--mono);
  color: var(--m);
}

.cd small {
  display: block;
  font: 400 11px var(--mono);
  color: #444;
}

.b2 {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-left: 8px;
  background: var(--m);
  color: #fff;
  font: 400 13.5px var(--mono);
  text-decoration: none;
  border: 0;
  padding: 9px 14px;
  cursor: pointer;
  text-transform: uppercase;
}

.b2::before {
  content: '';
  position: absolute;
  left: -8px;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--m);
}

.b2 svg {
  width: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.b3 {
  border-radius: 3px;
}

.b3::before {
  display: none;
}

/* =========================================
   KARTU ANIMASI
   ========================================= */
.rv {
  perspective: 1000px;
}

.rv:not(.card) {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity .9s, transform .9s;
}

.rv.in:not(.card) {
  opacity: 1;
  transform: none;
}

.card {
  margin-bottom: 22px;
}

.band {
  position: relative;
  background: var(--m);
  color: #e9d9a0;
  border-radius: 14px 14px 0 0;
  padding: 18px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 68px;
  transform: rotateX(180deg);
  transition: transform 1.25s cubic-bezier(.3,.9,.25,1) .15s;
  overflow: hidden;
}

.card.in .band {
  transform: none;
}

.band h3 {
  font: 700 19px/1.1 'Cormorant SC', serif;
  letter-spacing: .04em;
}

.band h3 small {
  display: block;
  font: italic 500 14px 'Cormorant Garamond', serif;
  letter-spacing: .02em;
  text-transform: uppercase;
  margin-top: 3px;
}

.band h3 em {
  display: block;
  font: 400 13px/1.25 var(--sg);
  font-style: normal;
  text-transform: none;
  letter-spacing: 0;
  margin-top: 2px;
  color: #f6efd0;
}

.band svg {
  flex: none;
  width: 120px;
  height: 46px;
  color: #fff;
  opacity: .95;
}

.band.ev svg {
  opacity: 1;
}

.band.fd svg {
  opacity: .28;
}

.cb {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 1.4s cubic-bezier(.3,.9,.25,1) .45s;
}

.card.in .cb {
  grid-template-rows: 1fr;
}

.cbi {
  overflow: hidden;
  min-height: 0;
}

.body {
  position: relative;
  background: #fbfdfa var(--guil);
  border: 1px dashed #3a3a3a;
  border-top: 0;
  border-bottom: 0;
  padding: 18px 16px 20px;
}

.body::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 70%;
  aspect-ratio: 1/1.03;
  transform: translate(-50%, -50%);
  background: var(--gar) center/contain no-repeat;
  opacity: .1;
  pointer-events: none;
}

.body > * {
  position: relative;
}

.foot {
  position: relative;
  background: #fbfdfa var(--guil);
  border: 1px dashed #3a3a3a;
  border-top: 1px dashed #222;
  border-bottom: 0;
  border-radius: 0;
}

.foot::before {
  content: '';
  display: block;
  height: 78px;
  margin: 0 20px;
  padding: 14px 0;
  background: var(--bar) center/100% 50px no-repeat;
}

.foot::after {
  content: '';
  display: block;
  height: 26px;
  background: var(--m);
  border-radius: 0 0 14px 14px;
}

.ev .body dl {
  margin-bottom: 12px;
}

.ev dt {
  color: #555;
  font-size: 10px;
}

.ev dd {
  font: 700 14.5px/1.3 var(--mono);
}

.ev dd.s {
  font-weight: 400;
  font-size: 14px;
}

/* =========================================
   GALERI
   ========================================= */
.gal {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.gal div {
  aspect-ratio: 3/4;
  background: linear-gradient(160deg, #d9c9d1, #9d8a98);
  overflow: hidden;
  display: grid;
  place-items: center;
  transform: scale(0);
  transition: transform .8s cubic-bezier(.3,1.3,.4,1);
  color: #fff;
  font: 700 22px var(--mono);
}

.gal div:nth-child(2) {
  grid-column: span 2;
  aspect-ratio: auto;
}

.gal div:nth-child(3n+1):nth-child(n+4) {
  background: linear-gradient(160deg, #c9b4bf, #7f6a77);
}

.card.in .gal div {
  transform: none;
}

.gal img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* =========================================
   CERITA
   ========================================= */
.tl {
  position: relative;
  padding-left: 34px;
}

.tl::before {
  content: '';
  position: absolute;
  left: 11px;
  top: 12px;
  bottom: 70px;
  width: 3px;
  background: var(--m);
}

.tl div {
  position: relative;
  margin-bottom: 18px;
  transform: scale(.55);
  transform-origin: 0 0;
  opacity: .3;
  transition: transform .9s cubic-bezier(.2,.9,.2,1), opacity .9s;
}

.card.in .tl div {
  transform: none;
  opacity: 1;
}

.tl div::before {
  content: '♥';
  position: absolute;
  left: -33px;
  top: 0;
  width: 25px;
  height: 25px;
  border-radius: 50%;
  background: var(--m);
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 12px;
}

.tl div:last-of-type::before {
  background: #8a8a8a;
}

.tl h4 {
  font: 700 17px var(--sg);
  color: var(--m);
  margin-bottom: 3px;
}

.tl p {
  font: 400 14px/1.35 var(--sg);
  text-align: justify;
  hyphens: auto;
}

/* =========================================
   UCAPAN DAN HADIAH
   ========================================= */
form {
  display: grid;
  gap: 10px;
}

input[type=text],
textarea {
  font: 400 14px var(--sg);
  padding: 11px 12px;
  border: 1px solid var(--m);
  border-radius: 9px;
  background: #fff;
  width: 100%;
  color: #222;
}

.rs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.rs label {
  border: 1px solid var(--m);
  border-radius: 9px;
  padding: 9px;
  text-align: center;
  font: 500 14px var(--sg);
  color: var(--m);
  cursor: pointer;
  display: flex;
  justify-content: center;
  gap: 6px;
  align-items: center;
}

.rs input {
  display: none;
}

.rs label:has(input:checked) {
  background: var(--m);
  color: #fff;
}

.rs svg {
  width: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
}

.send {
  border: 0;
  background: var(--m);
  color: #fff;
  font: 500 15px var(--sg);
  padding: 12px;
  border-radius: 9px;
  cursor: pointer;
}

.lbl {
  font: 500 14px var(--sg);
  margin-top: 4px;
}

.ms {
  margin-top: 14px;
  max-height: 310px;
  overflow: auto;
  display: grid;
  gap: 14px;
  font-family: var(--sg);
}

.m {
  display: flex;
  gap: 9px;
}

.m i {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--m);
  display: grid;
  place-items: center;
  color: #fff;
}

.m i svg {
  width: 18px;
  fill: currentColor;
}

.m b {
  font-size: 14px;
  color: var(--m);
}

.m b u {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  margin-left: 5px;
  vertical-align: -1px;
  background: #22c55e;
}

.m b u.x {
  background: #e11d48;
}

.m small {
  display: block;
  font-size: 11px;
  color: #555;
}

.m p {
  font-size: 13.5px;
}

.gf {
  text-align: center;
  font: 400 14px/1.35 var(--sg);
}

.gf p {
  margin-bottom: 14px;
}

.bk {
  display: none;
  margin-top: 16px;
  text-align: left;
}

.bk.on {
  display: grid;
  gap: 10px;
}

.bk div {
  background: var(--m);
  color: var(--cr);
  border-radius: 10px;
  padding: 12px 14px;
}

.bk small {
  font-size: 10px;
  letter-spacing: .1em;
}

.bk b {
  display: block;
  font: 700 18px var(--mono);
  margin: 3px 0;
}

.bk button {
  margin-top: 6px;
  border: 0;
  background: var(--cr);
  color: var(--m);
  font: 700 11px var(--mono);
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
}

/* =========================================
   PENUTUP
   ========================================= */
#end {
  padding: 60px 16px 40px;
  text-align: center;
  background-position: 50% 30%;
}

.cl {
  position: relative;
  width: min(80vw, 340px);
  aspect-ratio: 1;
  margin: 0 auto 6px;
}

.cl svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

#end p {
  font-size: 13.5px;
  line-height: 1.4;
  margin: 6px 10px;
}

#end .sal {
  margin: 8px 0 22px;
}

#end h2 {
  font: 400 31px/1.1 'Special Elite', serif;
  margin-top: 4px;
  color: var(--cr);
}

.mw {
  text-align: center;
  padding: 22px 0 0;
  font: 400 13px var(--sg);
  color: #222;
}

/* =========================================
   NAVIGASI DAN MUSIK
   ========================================= */
.dock {
  position: fixed;
  z-index: 50;
  left: 50%;
  bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
  padding: 6px;
  border-radius: 18px;
  background: #fffffff2;
  box-shadow: 0 4px 18px #0003;
  backdrop-filter: blur(8px);
  transition: background .4s;
}

.dock a {
  position: relative;
  width: 38px;
  height: 42px;
  border-radius: 9px;
  background: var(--m);
  display: grid;
  place-items: center;
  transition: background .4s, opacity .4s;
}

.dock svg {
  width: 23px;
  fill: none;
  stroke: var(--cr);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.dock.d {
  background: #4a15297a;
}

.dock.d a {
  background: #ffffff14;
}

.dock a .tp {
  position: absolute;
  bottom: 56px;
  left: 50%;
  transform: translateX(-50%);
  background: #3a3a3acc;
  color: #fff;
  font: 400 10px var(--sg);
  padding: 3px 9px;
  border-radius: 5px;
  opacity: 0;
  transition: opacity .3s;
  white-space: nowrap;
  pointer-events: none;
}

.dock a.on .tp {
  opacity: 1;
}

.dock a[data-k=home] .tp {
  display: none;
}

#mus {
  position: fixed;
  z-index: 50;
  bottom: calc(86px + env(safe-area-inset-bottom, 0px));
  right: max(12px, calc(50vw - 203px));
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 0;
  background: #8d5a6c;
  color: #fff;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: background .4s;
}

#mus svg {
  width: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
}

#mus.d {
  background: none;
  color: var(--cr);
}

#mus.pl svg {
  animation: nt 1s infinite alternate;
}

@keyframes nt {
  to { transform: translateY(-2px); }
}

/* Hormati preferensi gerakan minimal */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}

/* Penyempurnaan bagian pasangan pada layar PC */
@media screen and (min-width: 760px) {
  #couple {
    padding: 70px 40px 60px;
  }

  #couple .couple-title {
    font-size: 38px;
  }

  #couple .couple-title span {
    font-size: 46px;
  }

  #couple .verse-box {
    max-width: 620px;
    padding: 28px 36px;
  }

  #couple .ar {
    font-size: 28px;
  }

  #couple .q {
    max-width: 540px;
    font-size: 15px;
  }

  #couple .op {
    max-width: 620px;
    font-size: 15px;
  }

  #couple #pps {
    max-width: 380px;
  }
}
