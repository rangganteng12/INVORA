var $=function(i){return document.getElementById(i)},B=document.body,Q=function(s){return document.querySelectorAll(s)};
$('guest').textContent=new URLSearchParams(location.search).get('to')||C.tamu;
Q('.n').forEach(function(e){e.textContent=C.n1.toUpperCase()+' & '+C.n2.toUpperCase()});Q('.dt').forEach(function(e){e.textContent=C.tgl});
$('fin').textContent=C.n1+' & '+C.n2;
if(C.fotoBerdua){$('cimg').setAttribute('href',C.fotoBerdua);$('ctx').remove()}
// barcode
(function(){var x=0,s='',r=7;function rnd(){r=(r*9301+49297)%233280;return r/233280}
 while(x<300){var w=1+Math.floor(rnd()*4);if(rnd()>.35)s+='<rect x="'+x+'" width="'+w+'" height="50"/>';x+=w+1+Math.floor(rnd()*2)}
 var v='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+x+' 50" preserveAspectRatio="none"><g fill="#111">'+s+'</g></svg>';
 document.documentElement.style.setProperty('--bar','url("data:image/svg+xml,'+encodeURIComponent(v)+'")')})();
// passport
var PH='<svg viewBox="0 0 90 114"><defs><linearGradient id="pg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d6dce2"/><stop offset="1" stop-color="#8e9aa8"/></linearGradient></defs><rect width="90" height="114" fill="url(#pg)"/><circle cx="45" cy="42" r="17" fill="#fff" fill-opacity=".75"/><path d="M12 114c2-30 16-40 33-40s31 10 33 40z" fill="#fff" fill-opacity=".75"/></svg>';
function pass(p){return '<div class="pp rv"><div class="rep">REPUBLIK INDONESIA</div><h5>PASSPORT PROFILE</h5><small>PROFIL PASPOR</small><div class="top"><div class="pic">'+(p.foto?'<img alt="" src="'+p.foto+'">':PH)+'</div><dl><dt>TYPE / JENIS</dt><dd>'+p.jenis+'</dd><dt>CODE / KODE</dt><dd>IDN</dd><dt>PASSPORT NO. / NO. PASPOR</dt><dd>'+p.kode+'</dd></dl></div><div class="fold"></div><dl><dt>FULL NAME / NAMA LENGKAP</dt><dd>'+p.nama+'</dd><dt>DAUGHTER OF / '+p.ket+'</dt><dd class="s">'+p.ortu.join('<br>')+'</dd><dt>NATIONALITY / KEBANGSAAN</dt><dd class="s">INDONESIA <small style="font-size:9px">ID</small></dd></dl><svg class="stamp" viewBox="0 0 80 80"><use href="#glb" width="80" height="80"/><use href="#plane" x="-4" y="-6" width="30" height="30" transform="rotate(-40 11 9)"/></svg><hr><div class="mrz">'+p.jenis+' &lt;&lt; PASSPORT &lt;&lt; TO &lt;&lt; MARRIAGE &lt;&lt;<br>COUPLE &lt;&lt; IDN &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div></div>'}
$('pps').innerHTML=pass(C.p1)+pass(C.p2);
// cards
function card(cls,t,sub,fd,body){return '<div class="rv card '+cls+'"><div class="band '+(fd?'fd':'ev')+'"><h3>'+t+(fd?'<em>'+sub+'</em>':'<small>'+sub+'</small>')+'</h3><svg viewBox="0 0 120 46"><use href="'+(fd?'#glb':'#doodle')+'" width="120" height="46"/></svg></div><div class="cb"><div class="cbi"><div class="body">'+body+'</div></div></div><div class="foot"></div></div>'}
var MAP='<svg viewBox="0 0 24 24"><circle cx="10.500" cy="10.500" r="6"/><path d="M15 15l5 5M8 10.500h5M10.500 8v5"/></svg>';
$('event').innerHTML=C.acara.map(function(a){return card('ev',a.j,a.s,0,'<dl><dt>DATE / TANGGAL</dt><dd>'+a.t+'</dd><dt style="margin-top:12px">TIME / WAKTU</dt><dd class="s">'+a.w+'</dd><dt style="margin-top:12px">ADDRESS / ALAMAT</dt><dd class="s">'+a.a.join('<br>')+'</dd></dl><a class="b2 b3" href="'+a.m+'" target="_blank" rel="noopener" style="margin-left:0;border-left:4px solid var(--m);background:var(--m)">'+MAP+'Open Maps</a>')}).join('');
var gl=C.foto.length?C.foto:[1,2,3,4,5,6,7,8];
$('gallery').innerHTML=card('','Our Gallery','',0,'<div class="gal">'+gl.map(function(f){return '<div>'+(C.foto.length?'<img alt="" src="'+f+'">':'✦')+'</div>'}).join('')+'</div>');
$('story').innerHTML=card('','Love Story','',0,'<div class="tl">'+C.cerita.map(function(c){return '<div><h4>'+c[0]+'</h4><p>'+c[1]+'</p></div>'}).join('')+'<p style="font-size:13px;color:#333">Bismillahirrahmanirrahim</p></div>');
var ICO='<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-5 4-7 8-7s8 2 8 7z" fill="currentColor"/></svg>';
$('wishes').innerHTML=card('','Tinggalkan Do’a Ucapan','Berikan ucapan terbaik untuk Kedua Mempelai & Konfirmasi Kehadiran',1,'<form id="fm"><input type="text" id="fn" placeholder="Nama Kamu" required maxlength="40"><textarea id="ft" rows="3" placeholder="Berikan Ucapan & Do’a" required maxlength="300"></textarea><div class="lbl">Konfirmasi Kehadiran ?</div><div class="rs"><label><input type="radio" name="h" value="Hadir" checked><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/><path d="M6 10l3 3 5-6"/></svg>Hadir</label><label><input type="radio" name="h" value="Tidak Hadir"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/><path d="M7 7l6 6M13 7l-6 6"/></svg>Tidak Hadir</label></div><button class="send" type="submit">Send</button></form><div class="ms" id="ms"></div>');
$('gift').innerHTML=card('','Wedding Gift','',1,'<div class="gf"><p>Mungkin karena jarak, waktu ataupun keadaan yang menghalangi untuk ikut hadir dalam momen bahagia kami, Silakan klik tombol di bawah untuk mengirimkan kado/hadiah.</p><button class="b2 b3" id="amp" style="margin:0"><svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8S9 3 7 5s2 3 5 3 5-1 3-3-3 3-3 3"/></svg>Amplop Digital</button><div class="bk" id="bk">'+C.rek.map(function(r){return '<div><small>'+r.b+'</small><b>'+r.no+'</b>'+r.an+'<br><button data-c="'+r.no+'">SALIN NOMOR</button></div>'}).join('')+'</div></div>');
$('amp').onclick=function(){$('bk').classList.toggle('on')};
$('bk').onclick=function(e){var n=e.target.dataset.c;if(!n)return;try{navigator.clipboard.writeText(n)}catch(x){}e.target.textContent='TERSALIN ✓';setTimeout(function(){e.target.textContent='SALIN NOMOR'},1800)};
// countdown
var T=new Date(C.acara[0].iso);$('cd').innerHTML=['Days','Hours','Minutes','Seconds'].map(function(l){return '<div><span>00</span><small>'+l+'</small></div>'}).join('');
function tick(){var d=Math.max(0,T-new Date()),v=[Math.floor(d/864e5),Math.floor(d/36e5)%24,Math.floor(d/6e4)%60,Math.floor(d/1e3)%60];Q('#cd span').forEach(function(e,i){e.textContent=('0'+v[i]).slice(-2)})}
tick();setInterval(tick,1000);
var f=function(d){return d.toISOString().replace(/[-:]|\.\d+/g,'')};
$('cal').href='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent('Pernikahan '+C.n1+' & '+C.n2)+'&dates='+f(T)+'/'+f(new Date(+T+108e5));
// wishes
var W=[],KEY='wp-wishes';try{W=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){}
if(!W.length)W=[{n:'Sahabat',h:1,t:'Selamat menempuh hidup baru, semoga bahagia selalu!',d:'09-07-2026 13:19'},{n:'Keluarga',h:0,t:'Maaf belum bisa hadir, doa terbaik untuk kalian.',d:'14-05-2026 08:31'}];
function rw(){$('ms').innerHTML=W.map(function(){return '<div class="m"><i>'+ICO+'</i><div><b><span></span><u></u></b><small></small><p></p></div></div>'}).join('');
 Q('#ms .m').forEach(function(m,i){var w=W[i];m.querySelector('span').textContent=w.n;m.querySelector('u').className=w.h?'':'x';m.querySelector('small').textContent=w.d;m.querySelector('p').textContent=w.t})}
rw();
$('fm').onsubmit=function(e){e.preventDefault();var n=new Date();W.unshift({n:$('fn').value.trim(),h:document.querySelector('[name=h]:checked').value=='Hadir'?1:0,t:$('ft').value.trim(),d:n.toLocaleDateString('id-ID').replace(/\//g,'-')+' '+n.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'}).replace('.',':')});
 try{localStorage.setItem(KEY,JSON.stringify(W.slice(0,50)))}catch(x){}rw();$('fm').reset()};
// dock
var IC={home:['Home','M3 11l9-8 9 8v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z M12 17s-3-1.900-3-4a1.700 1.700 0 0 1 3-1 1.700 1.700 0 0 1 3 1c0 2.100-3 4-3 4z'],couple:['Couple','M8 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20v-1a6 6 0 0 1 12 0v1M17 9a2.500 2.500 0 1 0 0-5M17 14a5 5 0 0 1 5 5v1'],event:['Event','M4 5h16v15H4zM4 10h16M8 3v4M16 3v4M9 15h.01M12 15h.01M15 15h.01'],gallery:['Gallery','M6 3h12a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM12 16s-3-1.900-3-4a1.700 1.700 0 0 1 3-1 1.700 1.700 0 0 1 3 1c0 2.100-3 4-3 4z'],story:['Story','M9 18s-6-3.800-6-8a3.500 3.500 0 0 1 6-2.300A3.500 3.500 0 0 1 15 10M15 21s-6-3.800-6-8a3.500 3.500 0 0 1 6-2.300A3.500 3.500 0 0 1 21 13c0 4.200-6 8-6 8z'],wishes:['Wishes','M12 3a9 9 0 1 1-4.500 16.800L3 21l1.300-4.200A9 9 0 0 1 12 3zM12 15s-3.500-2.200-3.500-4.500a2 2 0 0 1 3.500-1.200 2 2 0 0 1 3.500 1.200c0 2.300-3.500 4.500-3.500 4.500z'],gift:['Gift','M3 8h18v4H3zM5 12v9h14v-9M12 8v13M12 8S9 3 7 5s2 3 5 3 5-1 3-3-3 3-3 3']};
$('dock').innerHTML=Object.keys(IC).map(function(k){return '<a href="#'+(k=='event'?'date':k)+'" data-k="'+k+'" aria-label="'+IC[k][0]+'"><span class="tp">'+IC[k][0]+'</span><svg viewBox="0 0 24 24"><path d="'+IC[k][1]+'"/></svg></a>'}).join('');
var ticking=0;function upd(){ticking=0;var h=innerHeight,k='home',d='l';
 Q('main section[data-k]').forEach(function(s){var r=s.getBoundingClientRect();if(r.top<h*.5)k=s.dataset.k});
 Q('main section[data-dock]').forEach(function(s){var r=s.getBoundingClientRect();if(r.top<h-40&&r.bottom>h-40)d=s.dataset.dock});
 Q('.dock a').forEach(function(a){a.classList.toggle('on',a.dataset.k==k)});$('dock').classList.toggle('d',d=='d');$('mus').classList.toggle('d',d=='d')}
addEventListener('scroll',function(){if(!ticking){ticking=1;requestAnimationFrame(upd)}},{passive:true});upd();
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)e.target.classList.add('in')})},{threshold:.18});Q('.rv').forEach(function(e){io.observe(e)});
// musik
var ac,tm,pl=0,N=[261.6,329.6,392,523.3,392,329.6,293.7,392];
function nt(i){var o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=N[i%8]/(i%16>7?2:1);g.gain.setValueAtTime(0,ac.currentTime);g.gain.linearRampToValueAtTime(.07,ac.currentTime+.05);g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+1.6);o.connect(g).connect(ac.destination);o.start();o.stop(ac.currentTime+1.700)}
function music(v){pl=v;$('mus').classList.toggle('pl',v);clearInterval(tm);if(v){try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();var i=0;tm=setInterval(function(){nt(i++)},650)}catch(e){}}}
$('mus').onclick=function(){music(!pl)};
$('go').onclick=function(){B.classList.add('open');setTimeout(function(){B.classList.remove('lock');upd()},1300);music(1)};
